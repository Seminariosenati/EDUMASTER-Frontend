# SITE_ADDRESS = dominio DNS (HTTPS automático con Let's Encrypt) o :80 para solo HTTP.
# PUBLIC_IP = IP pública de la VM: también se puede entrar por http://<IP> (sin HTTPS: no hay certificados para IPs).
(edumaster) {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000} {
			flush_interval -1
		}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{$SITE_ADDRESS::80} {
	import edumaster
}

http://{$PUBLIC_IP:127.0.0.1} {
	import edumaster
}
