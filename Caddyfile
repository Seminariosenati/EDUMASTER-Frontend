# SITE_ADDRESS=:80 sirve solo HTTP; con un dominio (p.ej. edumaster-linux.northcentralus.cloudapp.azure.com)
# Caddy obtiene automáticamente un certificado HTTPS de Let's Encrypt.
{$SITE_ADDRESS::80} {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000} {
			flush_interval -1
		}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
